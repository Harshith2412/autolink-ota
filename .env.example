# Copy to .env (docker compose) or let scripts/dev_setup.py generate .dev/backend.env.
# Never commit real values.
AUTOLINK_ENV=development
AUTOLINK_JWT_SECRET=replace-with-48+-random-characters
AUTOLINK_DATABASE_URL=sqlite:////data/autolink.db
AUTOLINK_BLOB_DIR=/data/blobs
AUTOLINK_TRUST_STORE=/config/trust.json
AUTOLINK_CORS_ORIGINS=http://localhost:5173
AUTOLINK_ACCESS_TOKEN_TTL_S=900
AUTOLINK_COMMAND_TTL_S=86400
AUTOLINK_OFFLINE_AFTER_S=30
AUTOLINK_ALLOW_SELF_APPROVAL=false
